---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for post in site.posts %}
    {% unless post.sitemap.exclude == true %}
    <url>
        <loc>{{ site.url }}{{ post.url | replace: ' ', '%20' }}</loc>
        <lastmod>{{ post.lastmod | default: post.date | date_to_xmlschema }}</lastmod>
    </url>
    {% endunless %}
    {% endfor %}
    {% for page in site.pages %}
    {% if page.url != null and page.sitemap.exclude != true %}
    {% assign ext = page.url | split: '.' | last %}
    {% comment %}
      Exact-path exclusions, not substring matches: a substring test on
      'feed' or 'search' would silently drop legitimate pages such as
      /research/ or /journal/feedback/. Paginator pages are excluded too —
      their content changes on every publish, so they are index churn.
    {% endcomment %}
    {% assign is_special = false %}
    {% if page.url == '/404.html' or page.url == '/sitemap.xml' or page.url == '/feed.xml' or page.url == '/search.html' or page.url == '/search/' or page.url == '/search.json' %}{% assign is_special = true %}{% endif %}
    {% if page.url contains '/journal/page' %}{% assign is_special = true %}{% endif %}
    {% unless is_special or ext == 'xml' or ext == 'json' or ext == 'txt' or ext == 'css' or ext == 'js' or ext == 'scss' or ext == 'map' %}
    <url>
        <loc>{{ site.url }}{{ page.url | replace: ' ', '%20' }}</loc>
        {% if page.lastmod %}
        <lastmod>{{ page.lastmod | date_to_xmlschema }}</lastmod>
        {% endif %}
    </url>
    {% endunless %}
    {% endif %}
    {% endfor %}
</urlset>