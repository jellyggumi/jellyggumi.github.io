---
layout: null
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
    {% for post in site.posts %}
    <url>
        <loc>{{ site.url }}{{ post.url }}</loc>
        {% if post.lastmod == null %}
        <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
        {% else %}
        <lastmod>{{ post.lastmod | date_to_xmlschema }}</lastmod>
        {% endif %}

        {% if post.sitemap.changefreq == null %}
        <changefreq>weekly</changefreq>
        {% else %}
        <changefreq>{{ post.sitemap.changefreq }}</changefreq>
        {% endif %}

        {% if post.sitemap.priority == null %}
        <priority>0.5</priority>
        {% else %}
        <priority>{{ post.sitemap.priority }}</priority>
        {% endif %}

    </url>
    {% endfor %}
    {% for page in site.pages %}
    {% if page.url != null and page.sitemap.exclude != true %}
    {% assign ext = page.url | split: '.' | last %}
    {% if ext == 'html' or page.url contains '/' %}
    {% unless page.url contains '404' or page.url contains 'sitemap' or page.url contains 'feed' or page.url contains 'search' or ext == 'xml' or ext == 'json' or ext == 'txt' or ext == 'css' or ext == 'js' or ext == 'scss' or ext == 'map' %}
    <url>
        <loc>{{ site.url }}{{ page.url }}</loc>
        {% if page.lastmod %}
        <lastmod>{{ page.lastmod | date_to_xmlschema }}</lastmod>
        {% endif %}
        <changefreq>{% if page.sitemap.changefreq %}{{ page.sitemap.changefreq }}{% else %}monthly{% endif %}</changefreq>
        <priority>{% if page.sitemap.priority %}{{ page.sitemap.priority }}{% else %}0.6{% endif %}</priority>
    </url>
    {% endunless %}
    {% endif %}
    {% endif %}
    {% endfor %}
</urlset>