			<script type="text/javascript">
				const articleToggleBtn = document.querySelector('.articleToggleBtn');
				const articlePopup = document.querySelector(".article_pop");
				const btns = document.querySelectorAll('.sizeButton');
			
				document.addEventListener("DOMContentLoaded", function() {
					let lastSize = Number(getLocalStorage());
			
					removeActiveClassAll();
			
					if (lastSize) {
						btns[lastSize - 1].parentNode.classList.add('active');
						setSize(lastSize);
					} else {
						btns[1].parentNode.classList.add('active');
						setSize(2);
					}
				})
			
				articleToggleBtn.addEventListener('click', function() {
					articlePopup.classList.toggle("show");
				})
			
			
				for (let i = 0; i < btns.length; i ++) {
					(function (cu_i) {
						console.log(btns[cu_i])
			
						btns[cu_i].addEventListener('click', function() {
							removeActiveClassAll();
							btns[cu_i].parentNode.classList.add('active');
							setSize(cu_i + 1)
							articlePopup.classList.remove("show");
						})
					})(i) 
				}
			
				function removeActiveClassAll() {
					for (var i = 0; i < btns.length; i ++) {
						btns[i].parentNode.classList.remove('active');
					}
				}
			
				function setSize(fontType) {
					let fontClass;
			
					switch (fontType) { 
						case 1 :  
							fontClass = "small";
							setLocalStorage(fontType)
							break;  
						case 2 :  
							fontClass = "medium";
							setLocalStorage(fontType)
							break;  
						case 3 :  
							fontClass = "large";
							setLocalStorage(fontType)
							break;  
						case 4 :  
							fontClass = "xlarge";
							setLocalStorage(fontType)
							break;  
						case 5 :  
							fontClass = "xxlarge";
							setLocalStorage(fontType)
							break;  
						default : 
							fontClass = "medium";
							console.log('>>')
					}  
			
					const newsContents = document.getElementById("articleContetns");
					newsContents.className = "article articleContetns " + fontClass;
				}
			
				function getLocalStorage() {
					return localStorage.getItem("lastSize");
				}
			
				function setLocalStorage(size) {
					localStorage.setItem("lastSize", size);
				}
				
				document.addEventListener('click', function(event) {
					if (articlePopup.classList.contains('show') && event.target !== articlePopup && !articlePopup.contains(event.target) && event.target !== articleToggleBtn) {
						articlePopup.classList.remove("show");
					}
				});
			</script>		
			
