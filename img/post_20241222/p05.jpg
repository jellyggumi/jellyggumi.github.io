<div class="mlt01 ssul" id="module_ssul" style="display:none">
	<div class="contents1">
		<div class="ssul_title cluster_title">
			<h3 class="title_txt"><em>썰</em> 커뮤니티에서 이 기사의 반응은?</h3>
			<button data-info="info" onclick="ndrclick('NEWRE02');ssulInfo(this)" class="ssul_info" title="자세히 보기"></button>
			<div class="ssul_info_pop" data-info="info">
				<button onclick="ssulInfoClose(this)" class="close">
					<span class="hide">자세히 보기 닫기</span>
				</button>
				<p class="txt" data-info="info">게시글의 내용은 '썰'커뮤니티 사용자들의 자유로운 의견으로 <br /> 네이트 뉴스와는 무관하며, '인기 많은' 게시글 순으로 노출됩니다.</p>
			</div>
		</div>
		<a class="rangking_more" href="#" onclick="ndrclick('NEWRE01')" id="moreSsul">더보기</a>
		<hr class="ssul_hr" />
		
		<div id="ssul_comment"></div>
				
		<div class="ssul_contents" id="nodata_link" style="display:none">
			<div class="ssul_txt">
				<span>기사에 대해 최초 썰 작성자가 될 수 있습니다!</span>
				<span>링크로 이야기하는 네이트 썰에서 기사에 대한 이야기를 나눠보세요.</span>
			</div>
			<a href="https://m.ssul.nate.com/write?auto=1&amp;link=https://news.nate.com/view/20230918n30715" onclick="ndrclick('NEWRE09');" class="ssul_write_btn">
				<span>썰 작성하러 가기</span>
			</a>
		</div>							
		<div class="ssul_contents" id="data_link" style="display:none">
			<div class="ssul_txt">
				<span>이 기사에 대해 이야기를 나누고 싶다면?</span>
				<span>링크로 이야기하는 네이트썰에 참여하세요!</span>
			</div>
			<a href="https://m.ssul.nate.com/write?auto=1&amp;link=https://news.nate.com/view/20230918n30715" onclick="ndrclick('NEWRE08');" class="ssul_write_btn">
				<span>썰 작성하러 가기</span>
			</a>
		</div>							
	</div>
</div>

<script type="text/javascript">
	// 썰 레버리지
	var ssulinfoBtn = document.querySelector('.ssul_info');
	var ssulPop = document.querySelector('.ssul_info_pop');
	var ssulCommentBtn = document.querySelectorAll('.ssul_comment .comment_count');
	function ssulInfo(e){
		ssulPop.classList.add('active');
	}
	function ssulInfoClose(e){
		ssulPop.classList.remove('active');
	}
	function ssulOpenComment(e){
		var ssulList = e.parentNode.parentNode;
		if(e.textContent.trim() === '0'){
			return false;
		} else {
			ssulList.classList.toggle('active');
		}
		}
		ssulCommentBtn.forEach((items, idx) => {
		if(items.textContent.trim() === '0'){
			items.classList.add('default');
		}
	})

	document.addEventListener('click', function(event) {
		if (ssulPop.classList.contains('active') && event.target !== ssulPop && !ssulPop.contains(event.target) && event.target !== ssulinfoBtn) {
			ssulInfoClose();
		}
	});
</script>


<script>
	var ssulCategory = 'ent'; // ad on/off

	function ssul_load(){
		if(navigator.userAgent.match(/Googlebot/i)) {
			 return false;
		}

		var topCtgrCd = 'ent';
		var listcount = 10;
		if (topCtgrCd != 'ent') {
			listcount = 5;
		}
		jQuery.ajax({
			type: "GET", 
			dataType: "json", 
			url: "https://extra-api.ssul.nate.com/v1/nate/posts/nate-link/hot?commentSize=3&natePostId=20230918n30715&size="+listcount,
			dataType: 'json', 
			success: function(ssul){
				if (ssul['code']=='SUCCESS') {
					jQuery("#moreSsul").attr('href', ssul.data.moreUrl);
	
					var postListCount = ssul.data.postList.length;
					if (postListCount == 0) {
						jQuery("#ssul_write_btn2").attr('href', ssul.data.moreUrl);
						jQuery("#nodata_link").show();
						jQuery("#data_link").hide();
						jQuery("#adtive_box_ssul").attr('src', 'about:blank');
						jQuery("#adview_ssul").hide();
					} else {
						jQuery("#nodata_link").hide();
						jQuery("#data_link").show();
						if(ssulCategory == 'ent'){
							jQuery("#adtive_box_ssul").attr('src', '//m.news.nate.com/etc/AdViewSsul');
							jQuery("#adview_ssul").show();
						}
						var postListData = '';
						
						jQuery.each (ssul.data.postList, function (index, el) {
							var postId = el.postId;

							// 댓글이 0개일 경우 class 추가
							var countClass = ' default';
							if (el.commentCount > 0 ) {
								countClass = '';
							}

							// 댓글카운트
							var commentCount = el.commentCount;
							var showCount = 0;
							if (commentCount > 9999) {
								showCount = '9,999+'
							} else {
								showCount = commentCount.toLocaleString();
							}
	
							postListData +='<li>';
							postListData +='<a href="'+el.url+'" onclick="ndrclick(\'NEWRE03\')"><dl class="comment_txt">';
							postListData +='<dt><p>'+el.nickName+'</p><span>'+el.createDate.substr(5)+'</span></dt>';
							postListData +='<dd>'+el.content+'</dd>';
							postListData +='</dl></a>';
							postListData +='<div class="comment_btns">';
							postListData +='<button onclick="ndrclick(\'NEWRE05\');ssulOpenComment(this);" class="comment_count' + countClass + '">'+showCount+'</button>';
							postListData +='<a href="'+el.url+'" class="comment_up_down" onclick="ndrclick(\'NEWRE04\')">';
							postListData +='<ul><li><div class="up">'+el.upCount+'</div></li><li><div class="down">'+el.downCount+'</div></li></ul></a>';
							postListData +='</div>';
	
							// 댓글이 있을경우
							if (el.commentList.length>0) {
								postListData +='<ul class="comment_reply">';
								
								jQuery.each (el.commentList, function (index2, el2) {
									var addBepleClass = '';
									if (el2.commentType=='Best') {
										addBepleClass += 'class="best"';
									}
									postListData +='<li><a href="'+el2.commentTargetUrl+'" onclick="ndrclick(\'NEWRE06\');">';
									postListData +='<dl class="comment_txt">';
									postListData +='<dt ' +addBepleClass+ '><p>'+el2.nickName+'</p><span>'+el2.createDate.substr(5)+'</span></dt>';
									postListData +='<dd>'+el2.content+'</dd>';
									postListData +='</dl>';
									postListData +='</a></li>';
								});
								
								postListData +='<li class="ssul_more_btn">';
								postListData +='<a href="'+el.commentViewUrl+'" class="" onclick="ndrclick(\'NEWRE07\');">댓글 전체보기</a>';
								postListData +='</li>';
								postListData +=' </ul>';
							}
							// -- 댓글이 있을경우
							postListData +='</li>';
						});
	
						var appendData = '';
						appendData += '<ul class="ssul_comment">';
						appendData += postListData;
						appendData += '</ul>';
						
						jQuery("#ssul_comment").append(appendData);

						// 썰 커뮤니티 반응 모듈 호출
						if (ssulCategory == 'ent' && ssul.data.postList.length >= 5) {
							jQuery("#ssul_summary_graph").attr('href', ssul.data.moreUrl);
							
							artc_sq = '20230918n30715';
							revision_key = ssul.data.revisionKey;
							ssul_summary_load(artc_sq, revision_key);
						} 
					}
					
					jQuery("#module_ssul").show();
				} else {
					jQuery("#module_ssul").hide();
				}
				
			},
			error: function(e){
			}
		});

	}

	ssul_load();
</script>
<!-- 썰 레버리지 영역 -->


<!-- 썰 커뮤니티 반응 -->
<div class="community" id="ssul_summary" style="display:none">
    <div class="community_title cluster_title">
        <h3 class="title_txt">이 기사에 대한 썰 긍정/부정 AI요약 의견</h3>
        <button data-info="info" onclick="ndrclick('react01');infoBtnFn().open(this)" class="community_info" title="자세히 보기"></button>
        <div class="community_info_pop" data-info="info">
            <button onclick="infoBtnFn().close(this)" class="close">
                <span class="hide">자세히 보기 닫기</span>
            </button>
            <p class="txt" data-info="info">OpenAI에서 제공하는 생성형 AI모델을 기반으로 썰 게시글의 <br />
                긍정 및 부정 의견을 분석하여 결과를 제공하기 때문에 정확하지 않을 수 있습니다.</p>
        </div>
    </div> 

    <div class="community_contents">
        <div class="graph_contents">
            <span class="happy_ic emoji_ic">
                <em class="happy_num num">50%</em>
            </span>
            <a href="#" onclick="ndrclick('react02');" class="graph_wrap" id="ssul_summary_graph">
                <!-- happy_graph 요소에만 style width 넣어주세요 -->
                <span class="happy_graph graph" style="width: 50%;"></span>
                <span class="angry_graph graph"></span>
            </a>
            <span class="angry_ic emoji_ic">
                <em class="angry_num num">50%</em>
            </span>
        </div>
        <div class="view_wrap">
            <button class="view_btn" onclick="ndrclick('react03');ssul_summary_react_ndr();">긍정/부정 의견 <span>자세히 보기</span></button>
            <div class="view_content">
                <div class="positive section">
                    <span class="title">긍정적 의견</span>
                    <ul id="positive_opinion_list">
                    </ul>
                </div>
                <div class="negative section">
                    <span class="title">부정적 의견</span>
                    <ul id="negative_opinion_list">
                    </ul>
                </div>
                <div class="summation">
                    <span class="title">종합 의견</span>
                    <span class="desc" id="general_opinion"></span>
                </div>
            </div>
        </div>
    </div>
  </div>
  
<script type="text/javascript">
    var community = document.querySelector('.community');

    function changePercent(happy, angry) {
        document.querySelector('.happy_num').innerText = happy +'%';
        document.querySelector('.happy_graph').stytle = 'width: '+ happy + '%';
        document.querySelector('.angry_num').innerText = angry +'%';

        document.querySelector('.happy_graph').classList.remove('graph_animation')

        setTimeout(viewContentFn, 0)
    }

    function infoBtnFn() {
        var community_infoBtn = community.querySelector('.community_info');
        var community_Pop = community.querySelector('.community_info_pop');

        function open(e){
            community_Pop.classList.add('active');
        }
        function close(e){
            community_Pop.classList.remove('active');
        }

        return {
            open : open,
            close : close
        }
    }

    document.addEventListener("click", function(event) {
        var pop = document.querySelector(".community_info_pop");
        var btn = document.querySelector('.community_info');
        
        if (!pop.contains(event.target) && !btn.contains(event.target)) {
            pop.classList.remove('active')
        }
    });

    function viewContentFn() {
        var view_btn = community.querySelector('.view_btn');
        var view_btn_span = view_btn.querySelector('span');
        var view_wrap = community.querySelector('.view_wrap');
        var isOpened = false;

        init();

        window.addEventListener('scroll', function() {
            addMotion('.happy_graph');
        })
        view_btn.addEventListener('click', function() {
            isOpened = isOpened? false : true;

            opinionContentsControl();
        }) 
        
		function init() {
			var navigationEntries = performance.getEntriesByType("navigation");

			if (navigationEntries.length > 0) {
				var navigationType = navigationEntries[0].type;

				switch (navigationType) {
					case "navigate":
						sessionStorage.removeItem('isOpened');
					break;
					case "reload":
						isOpened = sessionStorage.getItem('isOpened');
						opinionContentsControl();

					break;
					case "back_forward":
						isOpened = sessionStorage.getItem('isOpened');
						opinionContentsControl();

					break;
				}
			}

			setMotion('.happy_graph', '.happy_num');
			addMotion('.happy_graph');
		}

        function opinionContentsControl() {
            var boolValue;

			if (typeof(isOpened) === 'string') {
				boolValue = isOpened === "true" ? true : isOpened === "false" ? false : undefined;
			} else {
				boolValue = isOpened;
			}
			
            if (boolValue) {
            	sessionStorage.setItem('isOpened', isOpened);
                view_wrap.classList.add('on');
                view_btn_span.innerText = '접기'
            } else {
            	sessionStorage.setItem('isOpened', isOpened);
                view_wrap.classList.remove('on');
                view_btn_span.innerText = '자세히 보기'
            }
        }

        function addMotion(target) {
            var position = community.getBoundingClientRect().top;
            var _target = community.querySelector(target)
            var windowHeight = window.innerHeight;

            if (position <= windowHeight / 2) {
                _target.classList.add('graph_animation');
                // _target.classList.add('border');

                window.removeEventListener('scroll', addMotion);
            }
        }

        function limitPercentage(value) {
            return Math.max(0, Math.min(110, value));
        }

        function setMotion(targetGraph, targetNum) {
            var graph = community.querySelector(targetGraph);
            var num = community.querySelector(targetNum);
            var parcent = parseFloat(num.textContent);
            var styleSheet;

            graph.style.width = parcent + '%';

            if (parcent === 50) {
            	styleSheet =
            	'.graph_animation {' +
            	'  width: ' + parcent + '%;' +
            	'  animation: graphAnimation 1.8s ease-out forwards;' +
            	'  z-index: 2' +
            	'}' +
            	'@keyframes graphAnimation {' +
            	'  0% { width: ' + parcent + '%; }' +
            	'  15% { width: ' + limitPercentage(parcent + 12) + '%; }' +
            	'  25% { width: ' + limitPercentage(parcent - 12) + '%; }' +
            	'  50% { width: ' + limitPercentage(parcent + 4) + '%; }' +
            	'  75% { width: ' + limitPercentage(parcent - 4) + '%; }' +
            	'  100% { width: ' + parcent + '%; }' +
            	'}';

            } else {
            	styleSheet =
            	'.graph_animation {' +
            	'  width: ' + parcent + '%;' +
            	'  animation: graphAnimation 1.8s ease-out forwards;' +
            	'  z-index: 2' +
            	'}' +
            	'@keyframes graphAnimation {' +
            	'  0% { width: ' + parcent + '%; }' +
            	'  15% { width: ' + limitPercentage(parcent + 12) + '%; }' +
            	'  25% { width: ' + limitPercentage(parcent - 8) + '%; }' +
            	'  50% { width: ' + limitPercentage(parcent + 4) + '%; }' +
            	'  75% { width: ' + limitPercentage(parcent - 4) + '%; }' +
            	'  100% { width: ' + parcent + '%; }' +
            	'}';
            }

            var styleTag = document.createElement('style');

            styleTag.type = 'text/css';
            styleTag.innerText = styleSheet;
            document.head.appendChild(styleTag);
        }
    }

	function ssul_summary_load(artc_sq, revision_key){
		if(navigator.userAgent.match(/Googlebot/i)) {
			 return false;
		}

		// 아이돌24 기사뷰 제외처리
		if('e1100' == 'e0600'){
			return false;
		}
		
		jQuery.ajax({
			type: "GET", 
			dataType: "json", 
			url: "/view/summarySsul?artc_sq="+artc_sq+"&revision_key="+revision_key,
			dataType: 'json', 
			success: function(summary_result){
				if (summary_result['response_code']=='200') {
					var summary_data = summary_result['summary'];
					var ssul_summary = document.querySelector('#ssul_summary');

					changePercent(summary_data['positive_percentage'], summary_data['negative_percentage']); 
					
					var positive_opinion_list = ssul_summary.querySelector('#positive_opinion_list');
					summary_lines = Object.entries(summary_data['positive']);
					if ( summary_lines.length > 0 ) {
						summary_lines.forEach((summary_line) => {
							opinion_li = document.createElement('li');
							opinion_li.innerHTML = summary_line[1];
							positive_opinion_list.appendChild(opinion_li);
						});
					} else {
						opinion_li = document.createElement('li');
						opinion_li.innerHTML = '아직까지 긍정적인 의견이 없어요';
						positive_opinion_list.appendChild(opinion_li);
					}		

					var negative_opinion_list = ssul_summary.querySelector('#negative_opinion_list');
					summary_lines = Object.entries(summary_data['negative']);

					if ( summary_lines.length > 0 ) {
						summary_lines.forEach((summary_line) => {
							opinion_li = document.createElement('li');
							opinion_li.innerHTML = summary_line[1];
							negative_opinion_list.appendChild(opinion_li);
						});
					} else {
						opinion_li = document.createElement('li');
						opinion_li.innerHTML = '아직까지 부정적인 의견이 없어요';
						negative_opinion_list.appendChild(opinion_li);
					}
					
					ssul_summary.querySelector('#general_opinion').innerText = summary_data['general_opinion'];

					jQuery("#ssul_summary").show();
				} else {
					jQuery("#ssul_summary").hide();
				}
				
			},
			error: function(e){
			}
		});

	}

	function ssul_summary_react_ndr() {
        var view_btn = community.querySelector('.view_btn');
        var view_btn_span = view_btn.querySelector('span');

        if ( view_btn_span.innerText == '자세히 보기' ) {
			// ndr code
			sNdrPath = "//stat.nate.com/stat/stat.tiff?cp_url=[news_ndr.nate.com/react/";
			draw_ndr(sNdrPath);
		}		
	}    
</script>
