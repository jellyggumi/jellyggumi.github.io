										<script type="text/javascript" src="//news.nate.com/js/swiper.min.js"></script>
					
					<div class="mduCluster shortFormCluster" id="ent_wrap" style="display:none;">
						<h2 class="mduCluster_title">틈틈이 짧은 재미! 추천 숏폼</h2>
						<button class="slideBtn btnPrev none" onclick="ndrclick('NEVSHLBT');" aria-label="이전"></button>
						<div class="shortForm">
							<ul class="shortformWrap swiper-wrapper">
							</ul>
						</div>
						<button class="slideBtn btnNext" onclick="ndrclick('NEVSHRBT');" aria-label="다음"></button>
					</div>

					<script>
						function slideFunc(){
							var wrapper = document.querySelector('.shortFormCluster');
					        var btnNext = wrapper.querySelector('.btnNext');
					        var btnPrev = wrapper.querySelector('.btnPrev');
					        var slideTarget = document.querySelector('.shortForm');
					        var slideList = slideTarget.querySelectorAll('.swiper-slide');
					
					        var shortFormSlide = new Swiper(slideTarget, {
					            resistanceRatio: 0, 
					            slidesPerView: 'auto',  
					            on: {
					                slideChange: function () {
					                    if (this.activeIndex > 0) {
					                        btnPrev.classList.remove('none')
					                        btnNext.classList.remove('none')
					                    }
					                },
					                reachBeginning: function () {
					                    btnPrev.classList.add('none')
					                    btnNext.classList.remove('none')
					                },
					                reachEnd: function () {
					                    btnPrev.classList.remove('none')
					                    btnNext.classList.add('none')
					                }
					            }
					        })
					
					        if( slideList.length < 6){
					            shortFormSlide.remove();
					        }
					
					        btnPrev.addEventListener('click', function() {
					            shortFormSlide.slidePrev();
					        });
					
					        btnNext.addEventListener('click', function() {
					            shortFormSlide.slideNext();
					        });
					    }
					
					    function getData() {
					        var wrapper = document.querySelector('.shortFormCluster');
					        var shortForm = document.querySelector('.shortformWrap');
					
					        return fetch('//news.nate.com/data/batch/ind/shortform_youtube_top_100.json')
					            .then(function(response) {
					                return response.json();
					            })
					            .catch(function(error) {
					                console.log(error);
					
// 					                shortForm.innerHTML += 
// 					                    '<li class="shortFormList">' +
// 					                        '<span>컨텐츠를 로드할 수 없습니다.</span>' +
// 					                    '</li>';
					
// 					                wrapper.classList.add('noList')
					            });
					    }
					
					    function setData() {
					        getData().then(function(data) {
					            var result = data.result;
					            var shortArr = [];
					            if(typeof data.result.resultSet.youtube_recmd100.list !== 'undefined') {
									shortArr = Array.prototype.slice.call(result.resultSet.youtube_recmd100.list);
								}

					            if(shortArr.length > 5) {
					            	var entWrap = document.querySelector('#ent_wrap');
					            	entWrap.style.display = 'block';
						            var shortForm = document.querySelector('.shortformWrap');
						            var shuffleData = shortArr.sort(function() {
						                return Math.random() - 0.5;
						            });

						            var nClick = 'NEVSH';
						            
						            shuffleData.slice(0, 10).map(function(item, idx) {

						            	var nClickContent = nClick + (idx+1);
							            
						                shortForm.innerHTML += 
						                    '<li class="shortFormList swiper-slide">' +
						                        '<a href="https://shortform.nate.com/best?videoId='+item.videoId+'" onclick="ndrclick(\''+nClickContent+'\');" target="_blank">' +
						                        '<img class="img" src="' + item.thumbnail + '" alt="" />' +
						                        '<p class="text">' + item.videoTitle + '</p>' +
						                        '</a>' +
						                    '</li>';
						            });

						            slideFunc();
					            }
					        });
					    }
					
					    setData();
					</script>	                <!-- E : 연예 숏폼 모듈 -->
	                
