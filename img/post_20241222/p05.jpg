		<script type="text/javascript" src="//api.nateon.nate.com/js/note/note_common_v2_1_1.min.js" defer="defer"></script> <!-- 네이트온쪽지 api -->

	<script type="text/javascript">
	//<![CDATA[
		if (typeof(jQuery) != "undefined") {
			jQuery.noConflict();
		}	//jQuery protoType confilct prevent

		var sNewsDomain = "//news.nate.com";
		var sCommDomain = "//comm.news.nate.com";
		var bFirefox	= navigator.userAgent.indexOf("Firefox") > 0;

		function setIfrUrl(obj,url) {
			if ( bFirefox ) {
				var doc = obj.contentDocument;
				doc.location.replace(url);
			} else {
				obj.src = url;
			}
		}

					//모바일 브라우져 redirecting
			var mobilecp	= '1';
			var artcsq		= '20230918n30715';
			var return_sq	= '';
			var viewParam	= "";

			if ( return_sq == '') {
				viewRedirectMobile(mobilecp, artcsq, viewParam);
			} else if ( return_sq != '') {
				viewRedirectMobileCmt(mobilecp, artcsq, return_sq);
			}

			// 스포츠 스폰서바 확장시 관심지수 강제 close
			function rankClose() {
				nPop = '0';
				nCmt = '0';
				nUp = '0';
				sRegDtm = '2023-09-25 00:00';
				rankDisplay(nPop, nCmt, nUp, sRegDtm, false, true);
			}
		
		// 네이트온쪽지
		var enc_note="X4vK-D_8SHRfmodZ9thd-c9rxorJ1pzhwsaVF9eo074JFKuqRS9wD1MsCyjrzn-4fGiygy-KPOyaDC1LGOB70f7aOSMJJ691SRSQc0NjQBc";

		// document.ready
		jQuery(document).ready(function() {
			try {
				if (eval(Contents = document.getElementById('realArtcContents'))) {
					// 기사 본문 내 링크 모두 새창
					Links = Contents.getElementsByTagName('a');
					for (var i = 0; i < Links.length; i++) {
						Links[i].target="_void";
					}

										// 630 보다 큰 이미지 처리
					elemImg = Contents.getElementsByTagName('img');
					for (var j = 0; j < elemImg.length; j++ ) {
						if ( elemImg[j].width && elemImg[j].width > 611 ) {
							elemImg[j].setAttribute('height',parseInt((elemImg[j].height*611)/elemImg[j].width));
							elemImg[j].setAttribute('width','611');
						}
					}
									}

									// 한국 IP 체크.
					if ('' != '' && 'N' == 'Y') {
						if (eval(checkIP = document.getElementById('ifr_checkIP'))) {
							param_url = encodeURIComponent("//news.nate.com/");
							setIfrUrl(checkIP,sCommDomain + "/CheckIP?red=" + param_url);
						}
					}

																	// RankingNews 이미지 콜러(많이본 뉴스 데이터 수집)
					RankCall('',0);
				
								
					var emoticonUrl = "//comm.news.nate.com"+"/comment/articleEmoticonComment/ArticleEmoticonList?artc_sq=20230918n30715&mid=e1100"
					getEmoticonList(emoticonUrl);
	
					// 감정이모티콘 load
					var check_period_millisec = 60*1000; // 갱신 주기
					var check_max_limit = (30*(60*1000))/check_period_millisec; // 30분간
					var check_cnt = 0; // 갱신 횟수
					var check_stop = false; // 갱신 종료 여부
					function getArticleEmoticon() {
						// 중단 조건 확인
						if ( check_cnt > check_max_limit || check_stop == true ) {
							return;
						}
	
						getEmoticonList(emoticonUrl);
	
						check_cnt++;
						if ( check_cnt > check_max_limit ) {
							check_stop = true;
						} else {
							window.setTimeout( getArticleEmoticon, check_period_millisec );
						}
					}
					window.setTimeout( getArticleEmoticon, check_period_millisec );
							} catch (e) {}

			try {
				//----- S : 광고 -----//
				//  본문내 중간광고 lazy loading.  mnews redirec
				if(document.getElementById("ad_innerView")){
 					var script = document.createElement('script');
 	 				script.src = "//cyad1.nate.com/js.kti/nate/news@mid_rec_Middle3";
 	 				script.dataset.press_code="ts";
 	 				script.dataset.item_id="20230918n30715";
 	 				document.getElementById("ad_innerView").append(script);
				}

				if (eval(ADBanner = document.getElementById('AdRectangleBanner'))) {
					setIfrUrl(ADBanner,sNewsDomain + "/Etc/AdRectangleBanner?bViewPage=true&g_bRightAD=1&ctgr_cd=ent01");
				}
								
				if (eval(ADBanner = document.getElementById('AdRightTop'))) {
					setIfrUrl(ADBanner,sNewsDomain + "/Etc/AdRightTop?bViewPage=true&g_bRightAD=1");
				}

				if (eval(AdSabannerRight = document.getElementById('AdSabannerRight'))) {
					setIfrUrl(AdSabannerRight,sNewsDomain + "/Etc/AdSaBannerRight?bViewPage=true&g_bRightAD=1");
				}
				
				if (eval(ADFloat = document.getElementById('AdRectangleFloating'))) {
					setIfrUrl(ADFloat,sNewsDomain + "/Etc/AdRectangleFloating&ctgr_cd=ent01");
				}

				if (eval(ADShopSearch = document.getElementById('AdShopSearch'))) {
					setIfrUrl(ADShopSearch,"//shop.nate.com/shopbox/shopbox_V3.htm?n=9&c=1&svcpage=news");
				}
				if (eval(ADSocial = document.getElementById('AdRightMiddle'))) {
					setIfrUrl(ADSocial, sNewsDomain + '/etc/AdRightMiddle');
				}
				if (eval(AdIbl = document.getElementById('AdIbl'))) {
					setIfrUrl(AdIbl, sNewsDomain + '/etc/AdIbl');
				}

				if (eval(ADBand = document.getElementById('bandAD'))) {
					setIfrUrl(ADBand,sNewsDomain + "/Etc/BandAD");
				}

				if (eval(ADBottomRect = document.getElementById('bottomAdRect'))) {
					setIfrUrl(ADBottomRect,"/Etc/AdViewBottomRect&ctgr_cd=ent01");
				}

				if (eval(ADCommerce = document.getElementById('AdCommerce'))) {
					setIfrUrl(ADCommerce,"//shop.nate.com/shopbox/shopbox.htm?n=9&c=1&svcpage=news&w=290");
				}

				/* 첫 View 이미지 AD
				if (GetCookie('noviad')!=1 && mid.substr(0,1) == 'e' && eval(ADViewImg = document.getElementById('viewimg_ad'))) {
					setIfrUrl(ADViewImg,"/Etc/AdViewImg?ctgr_cd=ent01");
				} */

				if (eval(AdViewRightBottom = document.getElementById('AdViewRightBottom'))) {
					setIfrUrl(AdViewRightBottom, sNewsDomain + '/etc/AdRightBottom');
				}

				if (eval(ifr_sabanner = document.getElementById('ifr_sabanner_view'))) {
					setIfrUrl(ifr_sabanner, sNewsDomain + '/etc/AdSaBanner');
				}
								
				// 댓글 우측 광고 START
		        (function($){
		        	var flag = false; // adv visible flag
		            function onScorllBanner(){
		                var replyPosition = $('.ifr_reple').offset().top,
		                    windowH = $(window).height(),
		                    bannerPosition = replyPosition - windowH,
		                    p = $(window).scrollTop();

		                if(p >= bannerPosition) {
		                    if(!flag) {
		                        // 광고 불러오는 부분
		                        $('.ifr_reple').css({
		                            'position': 'relative',
		                        });

		                        $('.left-wing-banner').css({
		                            'position': 'absolute',
		                            'font-size': 0,
		                            'left': '-130px',
		                            'top': 0
		                        });

		                        $('.left-wing-banner').html('<iframe src="//news.nate.com/etc/adLeftComment" width="120" height="240" title="광고" noresize="noresize" scrolling="no" frameborder="0" marginheight="0" marginwidth="0"></iframe>');
		                        flag = true;
		                    }
		                }
		            }
		            $(window).bind('scroll', onScorllBanner);

		            $(window).resize(function(){
		                $(window).unbind('scroll');
		                $(window).bind('scroll', onScorllBanner);
		            });
		        }(jQuery));
		     	// 댓글 우측 광고 END


				//----- E : 광고 -----//

				var _news_ndr_br = "";
				var sNdrNewsPath= "";
