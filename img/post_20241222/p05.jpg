	<script type="text/javascript">
		const aiSummaryPopup = document.querySelector(".ai_summary_pop");

		function openAiSummaryPopup(){
			aiSummaryPopup.classList.remove("none");
			document.body.classList.add("of_hidden");
			errorMsg = '기사 요약 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.';

			jQuery.ajax({
				type: "GET", 
				dataType: "json", 
				url: "//comm.news.nate.com/view/summary?artc_sq=20230918n30715",
				dataType: 'json', 
				success: function(summary_result){
					if (summary_result['response_code']=='200') {
						summaryHtml = '<ul>';

						summary_lines = Object.entries(summary_result['summary']);
						summary_lines.forEach((summary_line) => {
							summaryHtml += '<li class="list"><span class="result-contents">' + summary_line[1] + '</span></li>'; 
						});

						summaryHtml += '<ul>';
						
						jQuery("#ai_summary_text").html(summaryHtml);
						jQuery("#ai_summary_loading").hide();
						jQuery("#ai_summary_error").hide();
						jQuery("#ai_summary_text").show();
					} else if (summary_result['response_code']=='403') {
						if (summary_result['response_msg'] != '')  errorMsg = summary_result['response_msg'];										
						jQuery("#ai_summary_error_text").html(errorMsg);
						jQuery("#ai_summary_loading").hide();
						jQuery("#ai_summary_error").show();
						jQuery("#ai_summary_text").hide();
					} else {
						if (summary_result['response_msg'] != '')  errorMsg = errorMsg + ' : ' + summary_result['response_msg'];
						jQuery("#ai_summary_error_text").html(errorMsg);
						jQuery("#ai_summary_loading").hide();
						jQuery("#ai_summary_error").show();
						jQuery("#ai_summary_text").hide();
					}
					
				},
				error: function(e){
					jQuery("#ai_summary_error_text").text(errorMsg);
					jQuery("#ai_summary_loading").hide();
					jQuery("#ai_summary_error").show();
					jQuery("#ai_summary_text").hide();
				}
			});			
		}

		function closeAiSummaryPopup(){
			aiSummaryPopup.classList.add("none");
			document.body.classList.remove("of_hidden");
		}
	</script>
 	

	<!-- articleContetns -->
	<div id="articleContetns" class="article medium">

	<!-- 부제목 -->
    
	<div class="content_view">

		<script type="text/javascript">
			sCtgr_cd = "ent01";
		</script>
					<!-- 추가 동영상 v1 -->
										
									
							
		<!-- 기사 내용 -->
		<div id="realArtcContents">

		<!--
		 google_ad_section_start(name=gad1) 
		-->	

					
[톱스타뉴스 김효진]'백반기행'에 순천 산채정식 식당이 소개됐다.<br><br><br>지난 15일 방송된 TV조선 '식객 허영만의 백반기행' 216회는 전남 순천 편으로 꾸며졌다.<br><br><br>이날 방송에는 전남 순천시 승주읍 죽학리에 위치한 식당이 소개됐다. 가게를 찾은 허영만과 정대세와 명서현은 산채정식을 주문했다.<br><div><br><br>			<div id="ad_innerView"></div>
			<br><div><div class="articleMedia mediaImageZoom"><span class="imageZoom"><span class="imgad_area"><img onclick="GoImg('//news.nateimg.co.kr/orgImg/ts/2023/09/18/15397063_1177602_287_org.jpg'); return false;" style="cursor:pointer;" id="mainimg0" onerror="blankImg(this,0,0)" src="//thumbnews.nateimg.co.kr/view610///news.nateimg.co.kr/orgImg/ts/2023/09/18/15397063_1177602_287_org.jpg" alt=""기본 반찬만 29가지"…'백반기행', 순천 산채정식 식당 소개"><iframe id="viewimg_ad" name="viewimg_ad" class="ad100" src="about:blank" width="0" height="0" title="광고" noresize="noresize" scrolling="no" frameborder="0" marginheight="0" marginwidth="0" allowtransparency="true"></iframe></span></span></div></div><br><br></div><br>기본 반찬으로는 감말랭이고추무침, 칠게튀김, 들깨죽순무침, 삼채무침, 열무보리물김치, 양념가지구이, 표고전, 도토리묵무침, 메밀전병 등 29가지가 나왔다.<br><br><br>삼채무침을 맛본 정대세는 "진짜 맛있다. 확실히 채소가 신선하다. 맵고 달콤하다"라고 감탄했다.<br><br><br>감말랭이고추무침을 맛본 허영만은 "맛있다"라고 말했고, 명서현은 "달콤하다. 감이랑 매실액이 들어가서 맛이 잘 어우러진다. 살짝 시큼하면서도 달콤함이 잘 어울린다"라고 설명했다.<br><br><br>칠게무침을 맛본 정대세는 "매콤하면서도 감칠맛이 느껴지니 맛있다"라고 말한 뒤 폭풍 먹방을 펼쳤다.<br><br><br>TV조선 '식객 허영만의 백반기행'은 매주 금요일 오후 8시 방송된다.<br><br>김효진 : reporter@topstarnews.co.kr /  취재 및 보도 Reporter@TopStarNews.co.kr<br>Copyright ⓒ 톱스타뉴스(<a href="http://www.topstarnews.net" target="_blank">www.TopStarNews.Net</a>) 무단전재 & 재배포 금지<br><p><strong><톱스타뉴스 추천기사></strong></p><p><strong><a href="http://www.topstarnews.net/news/articleView.html?idxno=15396720" target="_blank">&#8226; "쫀득쫀득하고 맛있어"…'백반기행', 순천 돼지생갈비 맛집 소개  </a></strong></p><p><strong><a href="http://www.topstarnews.net/news/articleView.html?idxno=15396272" target="_blank">&#8226; '토요일은 밥이 좋아' 제천 닭볶음탕칼국수만둣국 맛집 위치는? "식객 허영만의 백반기행, 닭칼만전골 그 곳"</a></strong></p><p><strong><a href="http://www.topstarnews.net/news/articleView.html?idxno=15396226" target="_blank">&#8226; '식객 허영만의 백반기행' 순천 맛집, 돼지생갈비-산채정식-이모카세 外 "정대세·명서현 부부와 함께…" [종합]</a></strong></p><p><strong><a href="http://www.topstarnews.net/news/articleView.html?idxno=15395905" target="_blank">&#8226; "삼채무침-열무김치-칠게튀김"…'백반기행', 순천 산채 노포 맛집 소개</a></strong></p><p><strong><a href="http://www.topstarnews.net/news/articleView.html?idxno=15395666" target="_blank">&#8226; "두부탕-두부보쌈"…'백반기행', 서울 도봉구 맛집 소개  </a></strong></p><script language="javascript" type="application/javascript">
